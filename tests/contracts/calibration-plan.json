  "search_candidate": "FTS5 trigram literal >=3 Unicode characters; direct authorized non-trash corpus instr fallback for1–2 characters. ASCII case folded, no spacing/camelCase rewrite; eligibility joins before ordering/snippets/LIMIT. Latest-version rows ranked by title literal presence then document id. This is a bounded literal candidate, not a production retrieval contract.",
  "measurements": {
    "cold": "Each operation opens a new SQLite connection with fresh SQLite page/prepared-statement cache; OS file cache is uncontrolled and likely warm. No OS-cache flush claim.",
    "warm": "Same configured connection; five repetitions of40queries and200metadata pages after seed",
    "metadata": "50-item authorized latest-version list with edge counts, SQL execution+row scan; excludes HTTP, UI, AI, download",
    "search": "SQL lookup+top5 row scan, separate from metadata latency",
    "percentiles": "Sorted observed samples, nearest-rank ceil(p*n)-1, milliseconds",
    "memory": "Go Alloc/Sys and process maxRSS with platform unit; diagnostic, not production daemon footprint",
    "idle": "Process user+system CPU delta / elapsed over250ms no-job interval before and after operations; runtime/connection fixture only",
    "db_size": "Main SQLite database after WAL checkpoint/truncate, plus separately observed WAL bytes"
  },
  "decisions_before_run": {
    "metadata_p95_300ms": "Adopt as INITIAL bounded engineering target only if cold and warm observed p95 <300ms; miss is a disclosed calibration limitation with TASK-010-04/owningfeature followup, not a releaseSLO or content cap",
    "topical_top5_90percent": "Adopt as INITIAL bounded retrieval target if >=90% of all40declared queries have an eligible relevant result in top5; report every miss and owner TASK-004-02/TASK-010-04. Miss diagnostic-only for this fixture freeze, never pretend general relevance",
    "privacy": "Zero denied/trash result leakage is REQUIRED independent invariant; failcheck blocks calibration, cannot trade off against ranking",
    "concurrency": "3 simulated owner clients+1 configured background worker,20barrier rounds on4real SQLite connections: exactly1CAS win+3conflicts eachround, no lostwrites; REQUIRED",
    "idle_memory": "Diagnostic-only measured fixture CPU/memory; no production threshold or continuously running model claim",
    "attempt_deadline": "Pure fixture work budgets separate from content admission; no AI calls"
  },
  "later_owners": [
    "TASK-004-02",
    "TASK-010-04",
    "TASK-002-02",
    "TASK-002-04",
    "TASK-002-05"
  ],
  "limits": [
    "Synthetic data/queries and simulated clients; no physical-device result",
    "No production importer/search/API/daemon, power-loss or cross-volume durability proof",
    "No universal latency/relevance or owner usefulness guarantee"
